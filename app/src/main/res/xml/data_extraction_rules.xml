<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml — same exclusions for API 31+ cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credentials.xml" />
    </device-transfer>
</data-extraction-rules>
